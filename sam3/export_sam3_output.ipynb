#!/usr/bin/env python3
"""Export existing SAM3 NPZ predictions into evaluation-friendly frame maps.

This does not load SAM3 and therefore does not use GPU memory.
"""

import argparse
import json
from pathlib import Path

import numpy as np
from PIL import Image


IMAGE_EXTENSIONS = (".png", ".jpg", ".jpeg", ".bmp")


def parse_args():
    parser = argparse.ArgumentParser(
        description="Convert existing SAM3 NPZ files to overlays and 2-D maps."
    )
    parser.add_argument("--npz", required=True, help="Directory of SAM3 NPZ files.")
    parser.add_argument("--rgb", required=True, help="Directory of matching RGB frames.")
    parser.add_argument("--out", default="sam3_output", help="Output root directory.")
    return parser.parse_args()


def source_stem(npz_path):
    stem = npz_path.stem
    return stem[:-5] if stem.endswith("_sam3") else stem


def frame_name(stem):
    return stem if stem.startswith("frame_") else f"frame_{stem}"


def find_rgb(rgb_dir, stem):
    candidates = [stem]
    if stem.startswith("frame_"):
        candidates.append(stem[6:])
    else:
        candidates.append(f"frame_{stem}")

    for candidate in candidates:
        for extension in IMAGE_EXTENSIONS:
            path = rgb_dir / f"{candidate}{extension}"
            if path.is_file():
                return path
    return None


def combine_instances(masks, scores):
    masks = np.asarray(masks)
    scores = np.asarray(scores)
    if masks.ndim == 4 and masks.shape[1] == 1:
        masks = masks[:, 0]
    if masks.ndim != 3:
        raise ValueError(f"Expected masks with shape [N,H,W], got {masks.shape}")
    if scores.shape != (masks.shape[0],):
        raise ValueError(f"Expected {masks.shape[0]} scores, got {scores.shape}")
    if masks.shape[0] > np.iinfo(np.uint16).max:
        raise ValueError("Too many instances for uint16 output")

    instance_map = np.zeros(masks.shape[1:], dtype=np.uint16)
    # Lower scores are written first, so higher scores win overlapping pixels.
    for index in np.argsort(scores, kind="stable"):
        instance_map[masks[index].astype(bool)] = int(index) + 1
    return instance_map


def make_overlay(rgb, instance_map, alpha=0.5):
    rng = np.random.default_rng(0)
    colors = rng.integers(
        50, 256, size=(int(instance_map.max()) + 1, 3), dtype=np.uint8
    )
    colors[0] = 0
    foreground = instance_map > 0
    overlay = rgb.astype(np.float32, copy=True)
    overlay[foreground] = (
        (1.0 - alpha) * overlay[foreground]
        + alpha * colors[instance_map[foreground]].astype(np.float32)
    )
    return overlay.astype(np.uint8)


def main():
    args = parse_args()
    npz_dir = Path(args.npz)
    rgb_dir = Path(args.rgb)
    output_dir = Path(args.out)
    overlay_dir = output_dir / "overlays"
    binary_dir = output_dir / "binary_maps"
    instance_dir = output_dir / "instance_maps"
    metadata_dir = output_dir / "metadata"
    for directory in (overlay_dir, binary_dir, instance_dir, metadata_dir):
        directory.mkdir(parents=True, exist_ok=True)

    npz_paths = sorted(npz_dir.glob("*.npz"))
    if not npz_paths:
        raise FileNotFoundError(f"No NPZ files found in {npz_dir}")

    exported = 0
    skipped = 0
    for npz_path in npz_paths:
        stem = source_stem(npz_path)
        rgb_path = find_rgb(rgb_dir, stem)
        if rgb_path is None:
            print(f"Skipping {npz_path.name}: no matching RGB frame")
            skipped += 1
            continue

        with np.load(npz_path, allow_pickle=False) as data:
            required = {"masks", "scores", "labels", "boxes"}
            missing = required.difference(data.files)
            if missing:
                raise KeyError(f"{npz_path} is missing keys: {sorted(missing)}")
            masks = data["masks"]
            scores = data["scores"]
            labels = data["labels"]
            boxes = data["boxes"]
            instance_map = combine_instances(masks, scores)

        image = Image.open(rgb_path).convert("RGB")
        rgb = np.asarray(image)
        if rgb.shape[:2] != instance_map.shape:
            raise ValueError(
                f"Shape mismatch for {stem}: RGB {rgb.shape[:2]}, "
                f"masks {instance_map.shape}"
            )

        binary_map = (instance_map > 0).astype(np.uint8)
        overlay = make_overlay(rgb, instance_map)
        name = frame_name(stem)

        np.save(binary_dir / f"binary_map_{name}.npy", binary_map)
        np.save(instance_dir / f"instance_map_{name}.npy", instance_map)
        Image.fromarray(overlay).save(overlay_dir / f"{name}.png")

        instances = []
        for index, (label, score, box) in enumerate(zip(labels, scores, boxes)):
            instance_id = index + 1
            instances.append(
                {
                    "instance_id": instance_id,
                    "label": str(label),
                    "score": float(score),
                    "box_xyxy": [float(value) for value in box],
                    "visible_pixels": int(np.count_nonzero(instance_map == instance_id)),
                }
            )
        with (metadata_dir / f"{name}.json").open("w", encoding="utf-8") as file:
            json.dump(
                {
                    "source_image": rgb_path.name,
                    "source_predictions": npz_path.name,
                    "image_size_hw": list(instance_map.shape),
                    "instances": instances,
                },
                file,
                indent=2,
            )

        exported += 1
        print(f"[{exported}] {stem}: {len(instances)} instances")

    print(f"Finished: exported {exported}, skipped {skipped} without matching RGB")


if __name__ == "__main__":
    main()
